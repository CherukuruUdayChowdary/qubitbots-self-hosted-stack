# Browser settings
BROWSER_PATH=<PLACEHOLDER>
BROWSER_USER_DATA=<PLACEHOLDER>
BROWSER_DEBUGGING_PORT=<PLACEHOLDER>
BROWSER_DEBUGGING_HOST=<PLACEHOLDER>
# Set to true to keep browser open between AI tasks
KEEP_BROWSER_OPEN=<PLACEHOLDER>
USE_OWN_BROWSER=<PLACEHOLDER>
BROWSER_CDP=<PLACEHOLDER>
# Display settings
# Format: WIDTHxHEIGHTxDEPTH
RESOLUTION=<PLACEHOLDER>
# Width in pixels
RESOLUTION_WIDTH=<PLACEHOLDER>
# Height in pixels
RESOLUTION_HEIGHT=<PLACEHOLDER>

# VNC settings
VNC_PASSWORD=<PLACEHOLDER>
